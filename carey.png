															<img loading="lazy" width="281" height="281" src="https://www.carey.com/wp-content/uploads/unlimited_elements/SHAMOKA-RAMI.png" class="attachment-large size-large wp-image-5596" alt="SHAMOKA-RAMI" srcset="https://www.carey.com/wp-content/uploads/unlimited_elements/SHAMOKA-RAMI.png 281w, https://www.carey.com/wp-content/uploads/unlimited_elements/SHAMOKA-RAMI-150x150.png 150w" sizes="(max-width: 281px) 100vw, 281px" />															</div>
		<div class="elementor-element elementor-element-ad88a6f e-con-full e-flex e-con e-child" data-id="ad88a6f" data-element_type="container" data-e-type="container">
