<style>
.pum-theme-world-cup-2026-popup-theme .pum-container {
  border-radius: 5px;
}

.pum-theme-world-cup-2026-popup-theme .worldcup-card {
  position: relative;
  width: 100%;
  max-width: 570px;
  height: 300px;
  margin: 0 auto;
  border-radius: 6px;
  font-family: "Proxima nova", Sans-serif;
}

/* LOGO */
.pum-theme-world-cup-2026-popup-theme .worldcup-logo {
  position: absolute;
  top: 30px;
  left: 30px;
  width: 100px;
}

.pum-theme-world-cup-2026-popup-theme .worldcup-logo img {
  width: 100%;
  display: block;
}

.pum-theme-world-cup-2026-popup-theme .worldcup-content {
  position: absolute;
  top: 30px;
  right: 35px;
  width: 290px;
  z-index: 999;
}

.pum-theme-world-cup-2026-popup-theme .worldcup-content h2 {
  font-size: 30px;
  font-weight: 500;
  line-height: 30px;
  margin: 0 0 25px;
  color: #212121;
}

.pum-theme-world-cup-2026-popup-theme .worldcup-content p {
  font-size: 14px;
  color: #212121;
  font-weight: 400;
  margin-bottom: 25px;
}

/* BUTTON */
.pum-theme-world-cup-2026-popup-theme .worldcup-btn {
  display: inline-block;
  background: #00447c;
  color: #fff;
  padding: 9px 30px;
  font-size: 17px;
  font-weight: 400;
  border-radius: 6px;
  text-decoration: none;
}

.pum-theme-world-cup-2026-popup-theme .worldcup-btn:hover {
  background-color: #ffffff;
  border: 1px solid #00447c;
  color: #00447c;
}

/* CAR */
.pum-theme-world-cup-2026-popup-theme .worldcup-car {
  position: absolute;
  left: -46px;
  bottom: -45px;
  width: 430px;
  z-index: 99;
}

.pum-theme-world-cup-2026-popup-theme .worldcup-car img {
  width: 100%;
  display: block;
}

/* MOBILE */
@media (max-width: 767px) {
  .pum-theme-world-cup-2026-popup-theme .pum-container {
    width: 90% !important;
  }

  .pum-theme-world-cup-2026-popup-theme .worldcup-card {
    height: auto;
  }

  .pum-theme-world-cup-2026-popup-theme .worldcup-content {
    position: relative;
    top: 30px;
    right: 0;
    width: 100%;
    padding: 0 20px;
    text-align: center;
  }

  .pum-theme-world-cup-2026-popup-theme .worldcup-content h2 {
    font-size: 30px;

  }

  .pum-theme-world-cup-2026-popup-theme .worldcup-logo {
    position: relative;
    margin: 20px auto 0px;
    left: 0;
    top: 0;
  }

  .pum-theme-world-cup-2026-popup-theme .worldcup-car {
    position: relative;
    width: 90%;
    margin: 20px auto 0;
    left: 0;
    bottom: -35px;
  }

  .pum-theme-world-cup-2026-popup-theme .middle-content-popup {
    display: none;
  }
	
  .pum-theme-world-cup-2026-popup-theme .pum-content+.pum-close {
    right: 10px !important;
    top: 10px !important;
  }
}</style>
