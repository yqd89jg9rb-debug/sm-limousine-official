<style>
/* ===============================
   ROOT VARIABLE
================================= */
:root {
    --topbar-height: 0px;
}

/* ===============================
   TOP NOTICE BAR
================================= */
#top-notice-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: #00447c;
    color: #fff;
    z-index: 99999;
    font-family: Arial, sans-serif;
    transition: transform 0.3s ease;
}

/* Hide on non-home pages */
body:not(.home):not(.front-page) #top-notice-bar {
    display: none;
}

/* ===============================
   DESKTOP HEADER OFFSET
================================= */
@media (min-width: 1025px) {
    .home #ast-desktop-header,
    .front-page #ast-desktop-header {
        position: relative;
        top: var(--topbar-height);
        transition: none !important;
        will-change: top;
    }

    body.top-bar-closed #ast-desktop-header {
        top: 0 !important;
    }

    /* Re-enable transition only after page is fully loaded */
    body.page-loaded #ast-desktop-header {
        transition: top 0.25s ease !important;
    }
}

/* ===============================
   MOBILE HEADER OFFSET
================================= */
@media (max-width: 1024px) {
    .home #ast-mobile-header,
    .front-page #ast-mobile-header {
        position: relative;
        top: var(--topbar-height);
        transition: none !important;
        will-change: top;
    }

    body.top-bar-closed #ast-mobile-header {
        top: 0 !important;
    }

    /* Re-enable transition only after page is fully loaded */
    body.page-loaded #ast-mobile-header {
        transition: top 0.25s ease !important;
    }

    #top-notice-bar {
        min-height: 44px;
        padding: 10px 0;
    }

    .top-bar-content {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        text-align: center;
        padding: 8px 60px 8px 40px;
        position: relative;
    }

    .top-bar-text {
        font-size: 12px;
        line-height: 1.4;
        width: 100%;
    }

    #top-bar-close {
        position: absolute;
        left: 10px;
        top: 8px;
        transform: none;
        font-size: 16px;
        width: 24px;
        height: 24px;
        line-height: 24px;
    }
}

/* ===============================
   CONTENT
================================= */
.top-bar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 15px;
    min-height: 37px;
}

.top-bar-text {
    font-size: 14px;
    font-weight: 700;
}

#top-bar-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
}

/* ===============================
   HIDE ANIMATION
================================= */
#top-notice-bar.hide {
    transform: translateY(-100%);
}

/* ===============================
   SMALL DEVICES
================================= */
@media (max-width: 480px) {
    .top-bar-text {
        font-size: 9px;
        line-height: 1.3;
    }

    .top-bar-content {
        padding: 8px 60px 8px 40px;
    }
}

/* ===============================
   ASTRA SAFETY
================================= */
#masthead {
    position: relative;
}

/* ===============================
   PREVENT LOGO DISAPPEARING
================================= */
.site-logo img,
.custom-logo,
.custom-logo-link img,
.ast-site-identity img {
    opacity: 1 !important;
    visibility: visible !important;
    transition: none !important;
}

/* ===============================
   STOP LOGO DISAPPEARING ON CLICK
================================= */
.site-logo,
.ast-site-identity,
.custom-logo-link,
.site-logo img,
.ast-site-identity img,
.custom-logo-link img,
.ast-site-identity .site-title,
.ast-site-identity .site-description {
    opacity: 1 !important;
    visibility: visible !important;
    transition: none !important;
    animation: none !important;
}

/* ===============================
   STOP WHITE BACKGROUND FLASH
================================= */
.ast-page-builder-template,
.hfb-header,
.home #ast-desktop-header,
.home  #ast-mobile-header,
.home  .main-header-bar,
.home  .ast-primary-header-bar {
	background:transparent !important;
    transition: none !important;
}

/* Prevent Astra fade-in animation on reload */
.ast-header-break-point .ast-mobile-header-wrap,
#ast-desktop-header .main-header-bar-wrap {
    animation: none !important;
    opacity: 1 !important;
}

/* ===============================
   PREVENT LOGO OVERLAP ON LOAD
================================= */
.home #ast-desktop-header,
.front-page #ast-desktop-header {
    position: relative;
    top: var(--topbar-height);
    transition: none !important;
    will-change: top;
}

/* Re-enable transition only after page is loaded */
body.page-loaded #ast-desktop-header {
    transition: top 0.25s ease !important;
}</style>
