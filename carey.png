					<h2 class="elementor-heading-title elementor-size-default">Regional VP, East</h2>				</div>
				<div class="elementor-element elementor-element-853de90 elementor-shape-rounded elementor-grid-0 e-grid-align-center elementor-widget elementor-widget-social-icons" data-id="853de90" data-element_type="widget" data-e-type="widget" data-settings="{&quot;htmega_fe&quot;:&quot;no&quot;}" data-widget_type="social-icons.default">
