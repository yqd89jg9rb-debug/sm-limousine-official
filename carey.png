				<div class="elementor-element elementor-element-8273fa5 elementor-widget elementor-widget-heading" data-id="8273fa5" data-element_type="widget" data-e-type="widget" data-settings="{&quot;htmega_fe&quot;:&quot;no&quot;}" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">President of International Operations</h2>				</div>
				<div class="elementor-element elementor-element-f1719e7 elementor-shape-rounded elementor-grid-0 e-grid-align-center elementor-widget elementor-widget-social-icons" data-id="f1719e7" data-element_type="widget" data-e-type="widget" data-settings="{&quot;htmega_fe&quot;:&quot;no&quot;}" data-widget_type="social-icons.default">
